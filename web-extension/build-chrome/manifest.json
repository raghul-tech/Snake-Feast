{
  "manifest_version": 3, 
  "name": "Snake Feast",
  "version": "2.0.0",
  "description": "Snake Feast is a modern twist on the classic snake game. Eat food, grow longer, unlock power-ups, and chase your high score — right from your browser toolbar.",
  "action": {
    "default_popup": "index.html",
    "default_width": 800,
    "default_height": 600
  },
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "64": "icon/64.png",
    "256": "icon/256.png"
  },
  "permissions": [],
  "background": {
    "service_worker": "sw.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon/16.png",
        "icon/32.png",
        "icon/48.png",
        "icon/64.png",
        "icon/256.png",
        "js/script.js",
        "js/scene.js",
        "js/phaser.min.js",
        "sw.js",
        "index.html",
        "css/style.css",
        "css/googlefonts.css",
        "manifest.json"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
