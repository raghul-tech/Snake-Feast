{
  "manifest_version": 3, 
  "name": "Snake Feast",
  "version": "1.2.1",
  "description": "Snake Feast: Control a snake, eat food, grow longer, and challenge your reflexes in this fun game. Aim for high scores!",
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "64": "icon/64.png",
    "256": "icon/256.png"
  },
  "permissions": [],
  "background": {
    "service_worker": "js/sw.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon/background1.png",
        "icon/microsoft.png",
        "icon/16.png",
        "icon/32.png",
        "icon/48.png",
        "icon/64.png",
        "icon/256.png",
        "js/jquery.min.js",
        "js/script.js",
        "js/sw.js",
        "index.html",
        "style.css",
        "manifest.json"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
